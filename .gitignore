# Ignore files by default; allow directories so Git can find approved files.
*
!*/

# Keep source code, project files, configuration, and documentation.
!.gitignore
!*.cs
!*.csproj
!*.sln
!*.config
!*.json
!*.md
!*.props
!*.targets
!*.sql
!*.yml
!*.yaml
!*.cshtml
!*.razor
!*.tt

# Always ignore generated and local-only directories.
**/[Bb]in/
**/[Oo]bj/
.vs/
.vscode/